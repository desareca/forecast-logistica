# Configuracion de forecast-logistica. Copiar a .env y ajustar si se requiere.
# Todas las variables tienen valor por defecto en src/logforecast/config.py.

# Rutas de datos y artefactos: locales (Docker) o s3:// (AWS). El codigo es el mismo.
LF_DATA_URI=/app/data/raw              # AWS: s3://<bucket>/raw
LF_ARTIFACTS_URI=/app/artifacts        # AWS: s3://<bucket>/artifacts

# Parametros del modelo y del endpoint
LF_MIN_HISTORY_DAYS=45                 # gate: dias minimos de historia continua por CD
LF_BIAS_TOLERANCE=0.05                 # tolerancia de bias (+/-5%)
LF_CAPACITY_WARN_RATIO=0.9             # uso de capacidad desde el que el endpoint avisa "CERCA"